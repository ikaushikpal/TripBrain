# Root .gitignore for TripBrain

# OS files
.DS_Store
Thumbs.db

# IDEs/Editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.classpath
.project
.factorypath
.apt_generated/
.springBeans
.sts4-cache

# Backend Build & Run
backend/.gradle/
backend/build/
backend/bin/
backend/out/
backend/uploads/
backend/db/
backend/.env
backend/db/**
.env
backend/src/main/resources/static/**


# Frontend Build & Run
frontend/trip-brain-frontend-app/.angular/
frontend/trip-brain-frontend-app/node_modules/
frontend/trip-brain-frontend-app/dist/
frontend/trip-brain-frontend-app/tmp/
frontend/trip-brain-frontend-app/.sass-cache/

# Local logs
*.log

# ignore pycache of scripts
**/__pycache__/**

# monitor Build & Run
monitor/trip-brain-monitor/.gradle/
monitor/trip-brain-monitor/build/
monitor/trip-brain-monitor/bin/
monitor/trip-brain-monitor/out/
monitor/trip-brain-monitor/uploads/
monitor/trip-brain-monitor/db/
monitor/trip-brain-monitor/.env
monitor/trip-brain-monitor/db/**
.env
monitor/trip-brain-monitor/src/main/resources/static/**