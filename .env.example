# =============================================================================
# TripBrain — Environment Variables Reference
# =============================================================================
# Copy this file to /opt/platform/.env on your server and fill in real values.
# =============================================================================


# -----------------------------------------------------------------------------
# AI / LLM APIs
# -----------------------------------------------------------------------------
GEMINI_KEY=your_google_gemini_api_key_here
GROQ_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
TAVILY_KEY=your_tavily_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://your-db-host:5432/tripbrain
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password


# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://your-redis-host:6379


# -----------------------------------------------------------------------------
# Vector Store
# -----------------------------------------------------------------------------
# Options: qdrant | opensearch
VECTORSTORE_TYPE=qdrant

# Qdrant
QDRANT_HOST=http://your-qdrant-host:6333
QDRANT_KEY=your_qdrant_api_key_here

# OpenSearch (only needed if VECTORSTORE_TYPE=opensearch)
OPENSEARCH_URIS=http://your-opensearch-host:9200
OPENSEARCH_USERNAME=your_opensearch_user
OPENSEARCH_PASSWORD=your_opensearch_password
OPENSEARCH_INDEX_NAME=pdf-lookup-app


# -----------------------------------------------------------------------------
# Storage — Backblaze B2 (S3-compatible)
# -----------------------------------------------------------------------------
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=trip-brain-storage
B2_ACCESS_KEY_ID=your_b2_access_key_id
B2_SECRET_ACCESS_KEY=your_b2_secret_access_key


# -----------------------------------------------------------------------------
# Logging Directory Override
# -----------------------------------------------------------------------------
# Default on Server/Linux: /data/tripbrain
# Default on Windows: %TEMP%\tripbrain (e.g. C:\Users\<User>\AppData\Local\Temp\tripbrain)
LOG_PATH=/data/tripbrain


# -----------------------------------------------------------------------------
# JWT Security
# -----------------------------------------------------------------------------
JWT_SECRET=your_256bit_hex_secret_here


# -----------------------------------------------------------------------------
# OCR — Tesseract (path to tessdata on the server)
# -----------------------------------------------------------------------------
TESSDATA_PATH=/usr/share/tesseract-ocr/5/tessdata


# -----------------------------------------------------------------------------
# Spring Boot Admin — Monitor Dashboard (spring.cloud1.mooo.com)
# -----------------------------------------------------------------------------
ADMIN_DASHBOARD_PORT=8085
SPRING_BOOT_ADMIN_PUBLIC_URL=https://spring.cloud1.mooo.com

# Credentials — must match on both the monitor server and the backend client
SPRING_ADMIN_USERNAME=your_admin_username
SPRING_ADMIN_PASSWORD=your_admin_password

# URL the backend uses to reach the monitor (internal Docker network name)
SPRING_BOOT_ADMIN_URL=http://trip-brain-monitor:8085


# -----------------------------------------------------------------------------
# Deployment — Gmail SMTP Notifications
# -----------------------------------------------------------------------------
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_PASSWORD_TOKEN=your_gmail_app_password_here
